{
	"_schema": "urn:inky:storage:schedule:tasks:1",
	"id": "e2e-timer-tasks",
	"name": "E2E Timer Tasks",
	"items": [
		{
			"id": "task1",
			"enabled": true,
			"title": "Quarter-hour clock",
			"task": {
				"plugin_name": "interstitial",
				"content": {
					"slideMinutes": 1,
					"dataSource": "clock",
					"clockFace": "Gradient Clock",
					"primaryColor": "#db3246",
					"secondaryColor": "#000000"
				}
			},
			"trigger": {
				"on_startup": false,
				"day": {
					"type": "dayofweek",
					"days": [
						0,
						1,
						2,
						3,
						4,
						5,
						6
					]
				},
				"time": {
					"type": "hourly",
					"minutes": [
						0,
						15,
						30,
						45
					]
				}
			}
		},
		{
			"id": "task2",
			"enabled": false,
			"title": "Paused year progress",
			"task": {
				"plugin_name": "interstitial",
				"content": {
					"slideMinutes": 5,
					"dataSource": "year_progress"
				}
			},
			"trigger": {
				"on_startup": false,
				"day": {
					"type": "dayofweek",
					"days": [
						1,
						3,
						5
					]
				},
				"time": {
					"type": "specific",
					"hour": 9,
					"minute": 30
				}
			}
		}
	]
}
