{
	"name": "eink-billboard",
	"private": true,
	"license": "Apache-2.0",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc -b && vite build",
		"preview": "vite preview",
		"lint": "eslint .",
		"api": "cd .. && uv run python -m scripts.export_openapi && cd app && openapi-typescript src/api/openapi.json -o src/api/schema.d.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"e2e": "npm run build && playwright test",
		"e2e:run": "playwright test"
	},
	"dependencies": {
		"@primeuix/themes": "^2.0.3",
		"@primevue/forms": "^4.5.5",
		"leaflet": "^1.9.4",
		"leaflet-geosearch": "^4.4.0",
		"pinia": "^4.1.0",
		"primeflex": "^4.0.0",
		"primevue": "^4.5.5",
		"vue": "^3.5.44",
		"vue-router": "^5.0.4",
		"xstate": "^5.33.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@material-symbols/svg-400": "^0.48.0",
		"@playwright/test": "~1.64.1",
		"@types/leaflet": "^1.9.21",
		"@vitejs/plugin-vue": "^6.0.5",
		"@vue/tsconfig": "^0.9.1",
		"eslint": "^10.12.0",
		"eslint-plugin-vue": "^10.11.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.3",
		"openapi-typescript": "^7.13.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.0.7",
		"vitest": "^5.0.5",
		"vue-tsc": "^3.2.6"
	},
	"overrides": {
		"openapi-typescript": {
			"typescript": "$typescript"
		}
	}
}
