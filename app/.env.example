# Where the web app finds the server (read by Vite when it builds or serves the app).
# Copy this file to .env.local to change it for yourself; .env.development and .env.production hold the defaults.
#
# The server answers /api on its own address:
#   production (the built app is served by the server itself): "/"
#   development (npm run dev on :5173, the server on :8080 with --cors http://localhost:5173): "http://localhost:8080/"
# A trailing slash is expected.
VITE_API_URL=/
