{
	"id": "slide-show",
	"name": "Slide Show",
	"version": "0.0.1",
	"class": "SlideShowAsync",
	"file": "slide_show.py",
	"module": "python.plugins.slide_show.slide_show",
	"description": "Media Gallery Slide Show.",
	"describe": "{dataSource}",
	"disabled": false,
	"features": ["layer-background", "layer-foreground", "media-image", "media-list"],
	"settings": {
		"schema": {
			"properties": [
			]
		},
		"default": null
	},
	"instanceSettings": {
		"schema": {
			"lookups": {
				"dataSource": {
					"schema": "data-sources",
					"features": ["layer-background", "layer-foreground"]
				}
			},
			"properties": [
				{
					"name": "dataSource",
					"type": "schema",
					"required": true,
					"default": null,
					"lookup": "dataSource",
					"title": "Data Source",
					"description": "Gallery single or list source."
				},
				{
					"name": "slideMax",
					"type": "integer",
					"required": true,
					"default": 4,
					"minimum": 0,
					"title": "Max Slides",
					"description": "Maximum number of images in the slideshow. Zero for 'unlimited'."
				},
				{
					"name": "slideMinutes",
					"type": "integer",
					"required": true,
					"default": 15,
					"minimum": 1,
					"title": "Slide Duration Minutes",
					"description": "Minutes per image."
				},
				{ "name": "showAs", "type": "string", "required": false, "default": "auto", "title": "Show As", "description": "auto: as the data source says (a text page overrides, a picture is a background). background: the overlays are drawn on it. blend: washes over the page before it, without the overlays. override: covers everything (only a priority image is drawn over it).", "enum": ["auto", "background", "blend", "override"]}
			]
		}
	}
}
