{
	"id": "priority-update",
	"name": "Priority Update",
	"version": "0.0.1",
	"class": "PriorityUpdateAsync",
	"file": "priority_update.py",
	"module": "python.plugins.priority_update.priority_update",
	"description": "A timer task that takes over the panel with a data source's page for its minutes, over or blended with what the playlist shows, then gives the panel back.",
	"describe": "{dataSource}",
	"disabled": false,
	"features": ["layer-priority", "media-image"],
	"settings": {
		"_schema": "urn:inky:storage:schema:plugin:priority-update:1",
		"schema": {
			"properties": [
			]
		},
		"default": null
	},
	"instanceSettings": {
		"schema": {
			"lookups": {
				"dataSource": {
					"schema": "data-sources",
					"features": ["layer-priority"]
				},
				"outputs": { "url": "/api/devices/outputs" },
				"cues": {
					"items": [
						{ "name": "Bell", "value": "bell" },
						{ "name": "One", "value": "one" },
						{ "name": "Two", "value": "two" },
						{ "name": "Three", "value": "three" },
						{ "name": "Steady", "value": "steady" },
						{ "name": "Slow", "value": "slow" },
						{ "name": "Fast", "value": "fast" },
						{ "name": "Heartbeat", "value": "heartbeat" }
					]
				}
			},
			"properties": [
				{
					"name": "dataSource",
					"type": "schema",
					"required": true,
					"default": null,
					"lookup": "dataSource",
					"title": "Data Source",
					"description": "Single image source."
				},
				{
					"name": "slideMinutes",
					"type": "integer",
					"required": true,
					"default": 1,
					"minimum": 1,
					"title": "Slide Duration",
					"units": "minutes",
					"description": "Minutes for image."
				},
				{ "name": "showAs", "type": "string", "required": false, "default": "priority", "title": "Show As", "description": "priority: covers the whole screen. blend: washes over what the playlist shows, and hides the overlays, for the same time.", "enum": ["priority", "blend"]},
				{ "name": "cueHeader", "type": "header", "title": "Output Cue", "collapsed": true },
				{
					"name": "cueOutput",
					"type": "string",
					"required": false,
					"default": null,
					"lookup": "outputs",
					"title": "Output",
					"description": "An output that plays a cue when this task runs, so a reminder is heard or felt as its page goes to the panel: one of the GPIO settings' Outputs. Empty: none. The quiet hours keep it still."
				},
				{
					"name": "cue",
					"type": "string",
					"required": true,
					"default": "bell",
					"lookup": "cues",
					"title": "Cue",
					"visibleIf": { "not": { "field": "cueOutput", "const": null } },
					"description": "What the output plays, once: a bell, a count (One, Two, Three) or a rhythm (Steady, Slow, Fast, Heartbeat)."
				}
			]
		}
	}
}
