{
	"id": "interstitial",
	"name": "Priority Update",
	"version": "0.0.1",
	"class": "PriorityUpdateAsync",
	"file": "priority_update.py",
	"module": "python.plugins.priority_update.priority_update",
	"description": "Pre-empts the current display with an image for a while (the priority layer), then the display goes back to what it was showing.",
	"describe": "{dataSource}",
	"disabled": false,
	"features": ["layer-priority", "media-image"],
	"settings": {
		"_schema": "urn:inky:storage:schema:plugin:interstitial:1",
		"schema": {
			"properties": [
			]
		},
		"default": null
	},
	"instanceSettings": {
		"schema": {
			"lookups": {
				"dataSource": {
					"schema": "data-sources",
					"features": ["layer-priority"]
				}
			},
			"properties": [
				{
					"name": "dataSource",
					"type": "schema",
					"required": true,
					"default": null,
					"lookup": "dataSource",
					"title": "Data Source",
					"description": "Single image source."
				},
				{
					"name": "slideMinutes",
					"type": "integer",
					"required": true,
					"default": 1,
					"minimum": 1,
					"title": "Slide Duration Minutes",
					"description": "Minutes for image."
				},
				{ "name": "showAs", "type": "string", "required": false, "default": "priority", "title": "Show As", "description": "priority: covers the whole screen. blend: washes over what the playlist shows, and hides the overlays, for the same time.", "enum": ["priority", "blend"]}
			]
		}
	}
}
