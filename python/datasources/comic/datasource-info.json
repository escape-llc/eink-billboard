{
	"id": "comic",
	"name": "Comic",
	"version": "0.0.1",
	"class": "ComicFeedAsync",
	"file": "comic_feed.py",
	"module": "python.datasources.comic.comic_feed",
	"description": "A comic downloader.",
	"disabled": false,
	"features": ["internet", "layer-foreground", "media-list"],
	"settings": {
		"schema": {
			"properties": [
			]
		},
		"default": null
	},
	"instanceSettings": {
		"schema": {
			"lookups": {
			},
			"properties": [
				{
					"name": "comic",
					"type": "string",
					"required": true,
					"default": "XKCD",
					"title": "Comic Source",
					"description": "Where to download comics.",
					"enum":[
						"XKCD",
						"Cyanide & Happiness",
						"Saturday Morning Breakfast Cereal",
						"The Perry Bible Fellowship",
						"Questionable Content",
						"Poorly Drawn Lines",
						"Dinosaur Comics",
						"webcomic name"
				]
				},
				{
					"name": "titleCaption",
					"type": "boolean",
					"required": false,
					"default": true,
					"title": "Show Caption",
					"description": "Display a caption."
				},
				{
					"name": "fontSize",
					"type": "integer",
					"minimum": 6,
					"required": true,
					"default": 12,
					"title": "Font size",
					"description": "The caption font size."
				}
			]
		}
	}
