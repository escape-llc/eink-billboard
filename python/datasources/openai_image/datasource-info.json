{
	"id": "openai-image",
	"name": "OpenAI Image Datasource",
	"version": "0.0.1",
	"class": "OpenAIAsync",
	"file": "openai_image.py",
	"module": "python.datasources.openai_image.openai_image",
	"description": "OpenAI Gen-AI images.",
	"features": ["internet", "api-key", "paid-service", "layer-background", "media-image"],
	"disabled": false,
	"settings": {
		"schema": {
			"properties": [
				{
					"name": "apiKey",
					"type": "string",
					"required": true,
					"writeOnly": true,
					"default": null,
					"title": "API Key",
					"description": "Your OpenAI API key."
				}
			]
		},
		"default": {
			"_id": "datasource-openai-image-settings",
			"apiKey": null
		}
	},
	"instanceSettings": {
		"schema": {
			"properties": [
				{
					"name": "imageModel",
					"type": "string",
					"required": true,
					"default": "dall-e-3",
					"title": "Image Model",
					"description": "OpenAI image model.",
					"enum": ["dall-e-3", "dall-e-2", "gpt-image-1"]
				},
				{
					"name": "dalle3Quality",
					"type": "string",
					"required": true,
					"default": "standard",
					"title": "Image Quality",
					"description": "DALL-E 3 image quality.",
					"enum": ["standard", "hd"],
					"visibleIf": { "field": "imageModel", "const": "dall-e-3" }
				},
				{
					"name": "gptImageQuality",
					"type": "string",
					"required": true,
					"default": "medium",
					"title": "Image Quality",
					"description": "GPT Image quality.",
					"enum": ["low", "medium", "high", "auto"],
					"visibleIf": { "field": "imageModel", "const": "gpt-image-1" }
				},
				{
					"name": "prompt",
					"type": "string",
					"required": true,
					"default": null,
					"title": "Prompt",
					"description": "Your Gen-AI prompt for the image."
				},
				{
					"name": "randomizePrompt",
					"type": "boolean",
					"required": false,
					"default": true,
					"title": "Randomize Prompt",
					"description": "Randomize the prompt."
				}
			]
		}
	}
}
