{
	"id": "image-folder",
	"name": "Image Folder",
	"version": "0.0.1",
	"class": "ImageFolderAsync",
	"file": "image_folder.py",
	"module": "python.datasources.image_folder.image_folder",
	"description": "Image folder data source.",
	"disabled": false,
	"features": ["filesystem", "layer-background", "media-list"],
	"settings": {
		"schema": {
			"properties": [
				{
					"name": "folders",
					"type": "array",
					"required": false,
					"default": [],
					"title": "Folders",
					"description": "The folders of images a task can show. A task picks one by its name.",
					"items": {
						"type": "object",
						"key": "name",
						"properties": [
							{ "name": "name", "type": "string", "required": true, "title": "Name", "minLength": 1 },
							{ "name": "path", "type": "string", "required": true, "title": "Folder Path", "minLength": 1 }
						]
					}
				}
			]
		},
		"default": {
			"folders": []
		}
	},
	"instanceSettings": {
		"schema": {
			"lookups": {
				"folder": { "settings": "folders", "value": "name" }
			},
			"properties": [
				{
					"name": "folder",
					"type": "string",
					"required": true,
					"default": null,
					"lookup": "folder",
					"title": "Folder",
					"description": "Which folder of images to show. Add folders in the Image Folder data source settings."
				}
			]
		}
	}
}
