{
	"id": "clock",
	"name": "Clock Data Source",
	"version": "0.0.1",
	"class": "ClockAsync",
	"file": "clock.py",
	"module": "python.datasources.clock.clock",
	"description": "A clock with various faces.",
	"disabled": false,
	"features": ["layer-priority", "layer-foreground", "media-image"],
	"settings": {
		"schema": {
			"properties": [
			]
		},
		"default": null
	},
	"instanceSettings": {
		"schema": {
			"lookups": {
			},
			"properties": [
				{
					"name": "clockFace",
					"type": "string",
					"required": true,
					"default": null,
					"title": "Clock Face",
					"description": "The clock face.",
					"enum": [
						"Gradient Clock",
						"Digital Clock",
						"Divided Clock",
						"Word Clock"
					]
				},
				{
					"name": "primaryColor",
					"type": "string",
					"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
					"required": true,
					"default": null,
					"title": "Primary Color",
					"description": "The primary color."
				},
				{
					"name": "secondaryColor",
					"type": "string",
					"pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
					"required": true,
					"default": null,
					"title": "Secondary Color",
					"description": "The secondary color."
				}
			]
		}
	}
}