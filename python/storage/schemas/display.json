{
	"_schema": "urn:inky:storage:schema:display:1",
	"schema": {
		"lookups":{
			"display": { "schema": "displays", "features": ["display-device"] },
		"orientation": {
				"items": [
					{ "name": "landscape", "value": "landscape" },
					{ "name": "portrait", "value": "portrait" }
				]
			}
		},
		"properties": [
			{
				"name":"display_type",
				"type": "schema",
				"title": "Display Type",
				"description": "The kind of display the pictures go to. Each kind has settings of its own, shown here once it is chosen. Restart after changing it.",
				"lookup": "display",
				"required": true
			},
			{
				"name":"orientation",
				"type": "string",
				"title": "Orientation",
				"lookup": "orientation",
				"required": true
			},
			{
				"name":"rotate180",
				"type": "boolean",
				"title": "Rotate 180",
				"required": false
			},
			{
				"name": "refreshInterval",
				"type": "integer",
				"title": "Rest After a Refresh",
				"units": "seconds",
				"description": "Seconds the panel rests after a refresh before it is sent another image, so the picture has time to settle and the panel is not worn by refreshing it too often. Pages that arrive meanwhile wait and the newest is drawn when the rest is over. A panel model may need more than this; 0 for no rest (a mock display).",
				"minimum": 0,
				"maximum": 3600,
				"required": true
			},
			{
				"name": "imageSettings",
				"type": "header",
				"title": "Image Settings"
			},
			{
				"name":"imageSettings-saturation",
				"type": "number",
				"title": "Saturation",
				"minimum": 0,
				"maximum": 2,
				"step": 0.1,
				"minFractionDigits": 1,
				"maxFractionDigits": 1,
				"required": true
			},
			{
				"name":"imageSettings-contrast",
				"type": "number",
				"title": "Contrast",
				"minimum": 0,
				"maximum": 2,
				"step": 0.1,
				"minFractionDigits": 1,
				"maxFractionDigits": 1,
				"required": true
			},
			{
				"name":"imageSettings-brightness",
				"type": "number",
				"title": "Brightness",
				"minimum": 0,
				"maximum": 2,
				"step": 0.1,
				"minFractionDigits": 1,
				"maxFractionDigits": 1,
				"required": true
			},
			{
				"name":"imageSettings-sharpness",
				"type": "number",
				"title": "Sharpness",
				"minimum": 0,
				"maximum": 2,
				"step": 0.1,
				"minFractionDigits": 1,
				"maxFractionDigits": 1,
				"required": true
			}
		]
	},
	"default": {
		"display_type": "mock",
		"orientation": "landscape",
		"rotate180": false,
		"refreshInterval": 60,
		"imageSettings-saturation": 1.0,
		"imageSettings-contrast": 1.0,
		"imageSettings-brightness": 1.0,
		"imageSettings-sharpness": 1.0
	}
}