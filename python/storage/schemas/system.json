{
	"_schema": "urn:inky:storage:schema:system:1",
	"schema": {
		"lookups": {
			"timezone":{
				"url": "/api/lookups/timezone"
			},
			"locale": {
				"url": "/api/lookups/locale"
			},
			"timeFormat": {
				"items": [
					{"name": "12h", "value": "12h" },
					{"name": "24h", "value": "24h" }
				]
			}
		},
		"properties": [
			{
				"name":"timezoneName",
				"type": "string",
				"title": "Timezone",
				"lookup": "timezone",
				"required": true
			},
			{
				"name":"locale",
				"type": "string",
				"title": "Locale",
				"lookup": "locale",
				"required": true
			},
			{
				"name":"timeFormat",
				"type": "string",
				"title": "Time Format",
				"lookup": "timeFormat",
				"required": true
			},
			{
				"name":"location",
				"type": "location",
				"title": "Location",
				"required": false
			}
		]
	},
	"default": {
		"timezoneName": "America/New_York",
		"locale": "en-US",
		"timeFormat": "24h",
		"location": null
	}
}