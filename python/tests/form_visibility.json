{
	"comment": "Cases both FormVisibility.ts and python/web/visibility.py must agree on.",
	"cases": [
		{
			"name": "no predicate",
			"predicate": null,
			"values": {},
			"visible": true
		},
		{
			"name": "eq false, value false",
			"predicate": {
				"field": "r",
				"const": false
			},
			"values": {
				"r": false
			},
			"visible": true
		},
		{
			"name": "eq false, value true",
			"predicate": {
				"field": "r",
				"const": false
			},
			"values": {
				"r": true
			},
			"visible": false
		},
		{
			"name": "eq false, unset is not false",
			"predicate": {
				"field": "r",
				"const": false
			},
			"values": {},
			"visible": false
		},
		{
			"name": "eq null matches unset",
			"predicate": {
				"field": "r",
				"const": null
			},
			"values": {
				"r": ""
			},
			"visible": true
		},
		{
			"name": "eq is strict about type",
			"predicate": {
				"field": "r",
				"const": 1
			},
			"values": {
				"r": true
			},
			"visible": false
		},
		{
			"name": "not const",
			"predicate": {
				"not": {
					"field": "r",
					"const": "a"
				}
			},
			"values": {
				"r": "b"
			},
			"visible": true
		},
		{
			"name": "not const, equal",
			"predicate": {
				"not": {
					"field": "r",
					"const": "a"
				}
			},
			"values": {
				"r": "a"
			},
			"visible": false
		},
		{
			"name": "in, member",
			"predicate": {
				"field": "r",
				"enum": [
					"a",
					"b"
				]
			},
			"values": {
				"r": "b"
			},
			"visible": true
		},
		{
			"name": "in, not a member",
			"predicate": {
				"field": "r",
				"enum": [
					"a",
					"b"
				]
			},
			"values": {
				"r": "c"
			},
			"visible": false
		},
		{
			"name": "set true, has value",
			"predicate": {
				"field": "r",
				"set": true
			},
			"values": {
				"r": "x"
			},
			"visible": true
		},
		{
			"name": "set true, empty string",
			"predicate": {
				"field": "r",
				"set": true
			},
			"values": {
				"r": ""
			},
			"visible": false
		},
		{
			"name": "set false, null",
			"predicate": {
				"field": "r",
				"set": false
			},
			"values": {
				"r": null
			},
			"visible": true
		},
		{
			"name": "all, one fails",
			"predicate": {
				"all": [
					{
						"field": "a",
						"const": 1
					},
					{
						"field": "b",
						"const": 2
					}
				]
			},
			"values": {
				"a": 1,
				"b": 3
			},
			"visible": false
		},
		{
			"name": "all, both hold",
			"predicate": {
				"all": [
					{
						"field": "a",
						"const": 1
					},
					{
						"field": "b",
						"const": 2
					}
				]
			},
			"values": {
				"a": 1,
				"b": 2
			},
			"visible": true
		},
		{
			"name": "any, one holds",
			"predicate": {
				"any": [
					{
						"field": "a",
						"const": 1
					},
					{
						"field": "b",
						"const": 2
					}
				]
			},
			"values": {
				"a": 0,
				"b": 2
			},
			"visible": true
		},
		{
			"name": "not",
			"predicate": {
				"not": {
					"field": "a",
					"set": true
				}
			},
			"values": {
				"a": "x"
			},
			"visible": false
		},
		{
			"name": "unknown predicate stays visible",
			"predicate": {
				"bogus": 1
			},
			"values": {},
			"visible": true
		},
		{
			"name": "eq 1, value 1.0 (one JSON number type)",
			"predicate": {
				"field": "a",
				"const": 1
			},
			"values": {
				"a": 1.0
			},
			"visible": true
		},
		{
			"name": "eq 1, value true is not the number",
			"predicate": {
				"field": "a",
				"const": 1
			},
			"values": {
				"a": true
			},
			"visible": false
		}
	]
}
