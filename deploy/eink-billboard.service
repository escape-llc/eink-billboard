# eInk Billboard as a systemd service on a Raspberry Pi. See "Running on a Raspberry Pi" in the readme.
# NOT TESTED ON A REAL PI yet: paths and group names are the usual ones; adjust them to your install.
#
#   sudo cp deploy/eink-billboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now eink-billboard
#   journalctl -u eink-billboard -f        # the setup code of a new device is here

[Unit]
Description=eInk Billboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=eink
Group=eink
# the panel is on SPI/GPIO: the groups that may use them (names differ a little between Raspberry Pi OS versions)
SupplementaryGroups=spi gpio i2c
WorkingDirectory=/opt/eink-billboard
# optional settings, mode 0600, owned by root (see the readme): EINK_API_TOKEN, EINK_ALLOW_HOSTS
EnvironmentFile=-/etc/eink-billboard.env
# /var/lib/eink-billboard is created for the service and is the only place it may write
StateDirectory=eink-billboard
ExecStart=/opt/eink-billboard/.venv/bin/python -m python.eink-billboard --storage /var/lib/eink-billboard --app /opt/eink-billboard/app/dist
Restart=on-failure
RestartSec=5

# port 80 without being root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# the rest of the system is read-only to it (the display needs /dev, so PrivateDevices stays off)
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
